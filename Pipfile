[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "==3.0.0"
werkzeug = "==3.0.1"
pandas = "==2.1.4"
numpy = "==1.26.2"
openpyxl = "==3.1.2"
python-dateutil = "==2.8.2"
xlrd = "==2.0.1"

[dev-packages]
pytest = "*"
black = "*"
flake8 = "*"
mypy = "*"
pytest-flask = "*"
pytest-cov = "*"

[requires]
python_version = "3.8"

[scripts]
start = "python app.py"
test = "pytest"
format = "black ."
lint = "flake8 ."
typecheck = "mypy ."
convert = "python generate_dashboard_data.py"
standalone = "python create_standalone_dashboard.py"
template = "python create_template.py"