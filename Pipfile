[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "==2.3.3"
werkzeug = "==2.3.7"
pandas = "==2.0.3"
numpy = "==1.24.4"
openpyxl = "==3.1.2"
xlrd = "==2.0.1"

[dev-packages]
pytest = "*"
black = "*"
flake8 = "*"
mypy = "*"
pytest-flask = "*"
pytest-cov = "*"

[requires]
python_version = "3.11"

[scripts]
start = "python app.py"
test = "pytest"
format = "black ."
lint = "flake8 ."
typecheck = "mypy ."
convert = "python generate_dashboard_data.py"
standalone = "python create_standalone_dashboard.py"
template = "python create_template.py"